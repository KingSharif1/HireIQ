NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only — required for Chrome extension token + POST /api/jobs
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude). Users can also paste their own key in Settings → AI.
ANTHROPIC_API_KEY=
# Optional: dedicated key for encrypting user BYOK secrets (defaults to hashing SERVICE_ROLE)
# AI_KEY_ENCRYPTION_SECRET=

# Hosted Auto-apply with HireIQ (Task 148 — Cloud Run worker)
# APPLY_WORKER_URL=https://<cloud-run-host>   # POST {runId} to /run
# APPLY_WORKER_SECRET=
# Local only (never on Vercel): APPLY_WORKER_INLINE=1

# Resend masked inbound (application email)
# Domain must be verified for Receiving in Resend (e.g. mail.kingsharif.com)
MASKED_EMAIL_DOMAIN=mail.kingsharif.com
RESEND_API_KEY=

# Svix signing secret from Resend → Webhooks → email.received
RESEND_WEBHOOK_SECRET=
# Optional: From address on the receiving domain for forward-to-inbox
# RESEND_FORWARD_FROM=HireIQ <noreply@mail.kingsharif.com>

# Google OAuth (Gmail readonly tracking — separate from Supabase Google login)
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: protect /api/cron/gmail-sync (Bearer or ?secret=)
# CRON_SECRET=

