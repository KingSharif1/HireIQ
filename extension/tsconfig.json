{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "noEmit": true,
    "paths": {
      "@hireiq/form-fill": ["../lib/extension/form-fill.ts"]
    }
  },
  "include": ["src/**/*.ts", "manifest.config.ts", "vite.config.ts"]
}
