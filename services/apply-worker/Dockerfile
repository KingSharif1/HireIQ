# Match installed playwright major.minor
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
# NODE_ENV=production makes npm ci skip playwright (it's a devDependency).
# The worker needs the playwright Node package; browsers come from the base image.
RUN npm ci && npm install tsx@4.19.3 playwright@1.60.0 --no-save

COPY tsconfig.json ./
# next-env.d.ts is gitignored (generated by Next locally) — stub it for tsx
RUN printf '%s\n' '/// <reference types="next" />' '/// <reference types="next/image-types/global" />' > next-env.d.ts
COPY lib ./lib
COPY types ./types
COPY services/apply-worker ./services/apply-worker

EXPOSE 8080

CMD ["npx", "tsx", "--tsconfig", "tsconfig.json", "services/apply-worker/server.ts"]
